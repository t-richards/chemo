root = true

[*]
indent_style = space

[*.{csproj,props,targets,slnx,manifest}]
indent_size = 2

[*.cs]
indent_size = 4

dotnet_analyzer_diagnostic.severity = warning

# Preferences for the rules that have options.

# Explicit types rather than var.
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = false
csharp_style_var_elsewhere = false

# new() when the type is already written on the left.
csharp_style_implicit_object_creation_when_type_is_apparent = true

# Collection expressions for literal collections, like [a, b] instead of new[] { a, b }.
dotnet_style_prefer_collection_expression = when_types_loosely_match

# using declarations when the using block runs to the end of its scope anyway.
csharp_prefer_simple_using_statement = true

# Accessibility modifiers on every type and member.
dotnet_style_require_accessibility_modifiers = for_non_interface_members

# Static holder classes should be static, whether or not they're public.
dotnet_code_quality.CA1052.api_surface = all

# Rules turned off because they don't fit Chemo.

# Treatments catch every exception on purpose, so one failure is logged and doesn't stop the rest.
dotnet_diagnostic.CA1031.severity = none

# Chemo's text isn't translated.
dotnet_diagnostic.CA1303.severity = none

# ConfigureAwait(false) would break Windows Forms code, which has to resume on the UI thread.
dotnet_diagnostic.CA2007.severity = none

# Chemo's enums mirror Windows constants, which don't always include zero.
dotnet_diagnostic.CA1008.severity = none

# LINQ chains keep ToList() and ToArray(), which read better than [.. query].
dotnet_diagnostic.IDE0305.severity = none

# Primary constructors would make fields that are readonly today mutable.
dotnet_diagnostic.IDE0290.severity = none

# Rewriting if statements as conditional expressions often reads worse.
dotnet_diagnostic.IDE0045.severity = none
dotnet_diagnostic.IDE0046.severity = none

# Switches only handle the cases that matter, without listing the rest.
dotnet_diagnostic.IDE0010.severity = none
dotnet_diagnostic.IDE0072.severity = none

# Methods whose return value isn't needed, like HashSet.Add, don't need a discard.
dotnet_diagnostic.IDE0058.severity = none
