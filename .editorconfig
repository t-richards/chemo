# Code style for Chemo. Builds report violations as warnings (EnforceCodeStyleInBuild in Directory.Build.props),
# and `dotnet format` fixes them.
root = true

[*]
indent_style = space

[*.{csproj,props,targets,slnx,manifest}]
indent_size = 2

[*.cs]
indent_size = 4

# Explicit types rather than var.
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = false
csharp_style_var_elsewhere = false
dotnet_diagnostic.IDE0008.severity = warning

# new() when the type is already written on the left.
csharp_style_implicit_object_creation_when_type_is_apparent = true
dotnet_diagnostic.IDE0090.severity = warning

# Collection expressions for literal collections, like [a, b] instead of new[] { a, b }. LINQ chains keep
# ToList() and ToArray(), which read better than [.. query].
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0305.severity = none

# using declarations when the using block runs to the end of its scope anyway.
csharp_prefer_simple_using_statement = true
dotnet_diagnostic.IDE0063.severity = warning

# Accessibility modifiers on every type and member.
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_diagnostic.IDE0040.severity = warning

# Seal classes nothing derives from, and make types and members static when they can be.
dotnet_diagnostic.CA1852.severity = warning
dotnet_diagnostic.CA1052.severity = warning
dotnet_code_quality.CA1052.api_surface = all
dotnet_diagnostic.CA1822.severity = warning
